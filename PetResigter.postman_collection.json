{
  "info": {
    "_postman_id": "2fb374a8-ae89-4dd8-9a9c-86088980a0d7",
    "name": "PetRegister",
    "description": "Register and authenticate a user, then manage that user's pet records.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Register",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"you@example.com\",\n  \"password\": \"a-password-at-least-12-characters\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('token', pm.response.json().token);",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Login",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"you@example.com\",\n  \"password\": \"a-password-at-least-12-characters\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('token', pm.response.json().token);",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "List my pets",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/pet"
      },
      "response": []
    },
    {
      "name": "Create pet",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"petName\": \"Snowy\",\n  \"description\": \"Snowy is a friendly pet who loves long walks, sunny windows, and spending time with family.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/pet"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('petId', pm.response.json()._id);",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get one pet",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/pet/{{petId}}"
      },
      "response": []
    },
    {
      "name": "Update pet",
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"petName\": \"Cocoa\",\n  \"description\": \"Cocoa is a friendly pet who loves long walks, sunny windows, and spending time with family.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/pet/{{petId}}"
      },
      "response": []
    },
    {
      "name": "Delete pet",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/pet/{{petId}}"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "petId",
      "value": ""
    }
  ]
}
